#!/usr/bin/env bash

# Return the Taskwarrior summary consumed by BarWidget.qml.

set -uo pipefail

tui_available=false
if command -v taskwarrior-tui >/dev/null 2>&1; then
  tui_available=true
fi

if ! command -v task >/dev/null 2>&1; then
  jq -cn \
    --argjson tuiAvailable "$tui_available" \
    '{
      available: false,
      tuiAvailable: $tuiAvailable,
      readError: false,
      total: 0,
      actionable: 0,
      tooltip: "Taskwarrior is not installed.\n\nLeft-click to install Taskwarrior and its TUI."
    }'
  exit 0
fi

normalize_count() {
  case "${1:-}" in
    ''|*[!0-9]*) printf '0' ;;
    *) printf '%s' "$1" ;;
  esac
}

read_error=false

if ! actionable_raw=$(task rc.color=off status:pending due.before:tomorrow count 2>/dev/null); then
  actionable_raw=0
  read_error=true
fi

if ! total_raw=$(task rc.color=off status:pending count 2>/dev/null); then
  total_raw=0
  read_error=true
fi

case "$actionable_raw" in
  ''|*[!0-9]*) read_error=true ;;
esac

case "$total_raw" in
  ''|*[!0-9]*) read_error=true ;;
esac

actionable=$(normalize_count "$actionable_raw")
total=$(normalize_count "$total_raw")

if ! list=$(task \
    rc.color=off \
    rc.verbose=nothing \
    rc.defaultwidth=0 \
    rc.report.omarchy.description=Omarchy \
    rc.report.omarchy.columns=due.relative,description.count \
    rc.report.omarchy.labels=Due,Task \
    rc.report.omarchy.sort=urgency- \
    status:pending limit:10 omarchy 2>/dev/null); then
  list=""
  read_error=true
fi

if [[ $read_error == true ]]; then
  tooltip="Taskwarrior data could not be read. Run task in a terminal to inspect the error, then right-click to refresh."
elif [[ -n $list ]]; then
  tooltip="$total pending | $actionable due today/overdue"$'\n\n'"$list"
else
  tooltip="No pending tasks"
fi

if [[ $tui_available != true ]]; then
  tooltip+=$'\n\nTaskwarrior TUI is not installed. Left-click to install it.'
fi

jq -cn \
  --argjson total "$total" \
  --argjson actionable "$actionable" \
  --argjson tuiAvailable "$tui_available" \
  --argjson readError "$read_error" \
  --arg tooltip "$tooltip" \
  '{
    available: true,
    tuiAvailable: $tuiAvailable,
    readError: $readError,
    total: $total,
    actionable: $actionable,
    tooltip: $tooltip
  }'
