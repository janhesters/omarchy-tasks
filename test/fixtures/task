#!/bin/bash

if [[ ${TASK_FIXTURE_MODE:-} == failure ]]; then
  exit 1
fi

if [[ ${TASK_FIXTURE_MODE:-} == invalid-counts && " $* " == *" count "* ]]; then
  printf 'not-a-number\n'
  exit 0
fi

case " $* " in
  *" due.before:tomorrow count "*)
    printf '2\n'
    ;;
  *" status:pending count "*)
    printf '5\n'
    ;;
  *)
    printf 'Due       Task\n'
    if [[ ${TASK_FIXTURE_MODE:-} == escaped ]]; then
      printf 'today     Review "quoted" task \\ path\n'
      printf 'tomorrow  Preserve a second line\n'
    else
      printf 'overdue   Ship Omarchy Tasks preview\n'
      printf 'today      Review plugin verification\n'
    fi
    ;;
esac
